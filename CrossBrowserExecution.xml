<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Execution">
    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="testpackage.CrossBrowserExecution">
                <methods>
                    <include name="clickOnComputerLink"/>
                    <include name="selectDesiredComputerOption"/>
                    <include name="addLaptopToCart"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="testpackage.CrossBrowserExecution">
                <methods>
                    <include name="clickOnComputerLink"/>
                    <include name="selectDesiredComputerOption"/>
                    <include name="addLaptopToCart"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="testpackage.CrossBrowserExecution">
                <methods>
                    <include name="clickOnComputerLink"/>
                    <include name="selectDesiredComputerOption"/>
                    <include name="addLaptopToCart"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>